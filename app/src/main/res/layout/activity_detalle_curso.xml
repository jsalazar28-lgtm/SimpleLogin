<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_gradient_background"
    android:padding="24dp"
    tools:context=".DetalleCursoActivity">

    <!-- Tarjeta Principal Limpia estilo Glassmorphism -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvMainContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#22FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Imagen Centrada -->
            <ImageView
                android:id="@+id/ivDetalleThumbnail"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_course_placeholder"
                android:contentDescription="Logo del Curso" />

            <!-- Título del Curso -->
            <TextView
                android:id="@+id/tvDetalleTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Título del Curso"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Botón de Categoría Estilo Píldora -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetalleCategoria"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#44FFFFFF"
                android:clickable="false"
                android:focusable="false"
                android:text="Categoría"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#33FFFFFF" />

            <!-- Nivel y Duración -->
            <TextView
                android:id="@+id/tvDetalleNivelDuracion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Nivel y Duración"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp"
                android:textStyle="italic" />

            <!-- Objetivos / Descripción -->
            <TextView
                android:id="@+id/tvDetalleDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Descripción detallada y objetivos del curso..."
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <!-- Información del Usuario Logueado dentro de la tarjeta -->
            <TextView
                android:id="@+id/tvUserWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Estudiante: jsalazar"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Botón Regresar Grande al fondo de la pantalla -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegresar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@android:color/white"
        android:text="Regresar"
        android:textAllCaps="false"
        android:textColor="#1A237E"
        android:textSize="16sp"
        android:minHeight="48dp"
        app:cornerRadius="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>